{
  "name": "assesspro-root",
  "version": "1.0.0",
  "description": "AssessPro - Continuous Assessment & Intelligence Portal (Full-Stack Decoupled Architecture)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix backend test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "education",
    "assessment",
    "react",
    "express",
    "supabase"
  ],
  "author": "BIT Sathy",
  "license": "ISC"
}
